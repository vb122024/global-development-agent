# Copy to backend/.env.local or store OPENAI_API_KEY in macOS Keychain later.
OPENAI_API_KEY=
CHAT_ENABLED=false
ADMIN_TOKEN=replace-with-a-long-local-secret
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEFAULT_MODEL=gpt-5-nano
REASONING_MODEL=gpt-5-mini
PER_RUN_BUDGET_USD=0
# Enter verified current prices before enabling cost estimates.
MODEL_INPUT_USD_PER_1M=0
MODEL_OUTPUT_USD_PER_1M=0
OPENAI_VECTOR_STORE_ID=
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=4000
SANDBOX_MODE=disabled
